# Copy this file to .env and fill in the real values.
# .env is never committed to GitHub.

OPENAI_API_KEY=sk-put-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Where the SQLite database file lives
DATABASE_URL=sqlite:///waste.db

# Default region used when the user has not chosen one
DEFAULT_REGION=Dortmund
